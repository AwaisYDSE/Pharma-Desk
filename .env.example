# PharmaDesk server — optional settings. Everything here can also be set by the owner in
# Settings → Email & SMS (stored encrypted on the server PC). Values here take priority.

# Email — Resend (free plan: https://resend.com) …
RESEND_API_KEY=
EMAIL_FROM="My Pharmacy <onboarding@resend.dev>"
# … or any SMTP account (e.g. Gmail with an App Password, Brevo, Mailjet)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS — TextBee (free, sends from your own Android phone: https://textbee.dev) …
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# … or Twilio (trial / paid)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Server
PORT=4317
# PHARMADESK_DATA=/path/to/data      (default: ~/PharmaDesk)
